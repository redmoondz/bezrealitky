FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-bot.txt requirements.txt ./
RUN pip install --no-cache-dir --disable-pip-version-check -r requirements-bot.txt

COPY src ./src
COPY bot ./bot
COPY config ./config

ENTRYPOINT ["python3", "-m", "bot.main"]
