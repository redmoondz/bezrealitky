# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# --- Postgres (used by the scheduler and the bot) ---
POSTGRES_DB=bezrealitky
POSTGRES_USER=bezrealitky
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Scheduler ---
# How often (in hours) the `scheduler` service re-scrapes the saved search.
SCRAPE_INTERVAL_HOURS=2

# --- Telegram bot ---
# From @BotFather.
TELEGRAM_BOT_API=

# Comma-separated Telegram user IDs allowed to browse listings, trigger the
# scraper, and view charts. Get your own ID from a bot like @userinfobot.
# Left empty, the bot refuses every gated command until this is set.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated subset of TELEGRAM_ALLOWED_USER_IDS above that additionally
# sees the Mini App's Admin tab (stats, user list, manual notifications).
TELEGRAM_ADMIN_USER_IDS=

# Each allowed user gets their own independent saved search and is notified
# automatically (at their own Telegram user ID) about new matches — there is
# no separate notify-recipients list to configure.

# How often (in seconds) the bot checks for newly relevant, unnotified listings.
NOTIFY_POLL_SECONDS=600

# More than this many new matches in one sync collapse into a single summary
# notification instead of one message per listing.
NOTIFY_BATCH_THRESHOLD=5

# Self-hosted LibreTranslate endpoint used to translate descriptions (mostly
# Czech) into whichever language a user picked with /start or /language.
# The compose `bot` service already points this at the `translate` service.
TRANSLATE_URL=http://translate:5000/translate

# --- Mini App (webapp/) ---
# Public HTTPS URL where the `webapp` compose service is reachable (e.g. a
# reverse-proxied domain, or an ngrok tunnel for local testing). Read by the
# bot to set its persistent menu button ("Open App"); leave empty to skip
# setting a menu button. Telegram requires this to be a real HTTPS URL — a
# bare `localhost` address can't be opened from inside the Telegram client.
WEBAPP_URL=
